FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update \
	&& apt-get install -y --no-install-recommends git \
	&& rm -rf /var/lib/apt/lists/*
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run simulator:fetch \
	&& npm --prefix vendor/pokemon-showdown ci --ignore-scripts \
	&& npm --prefix vendor/pokemon-showdown run build-npm
CMD ["npm", "run", "collect"]