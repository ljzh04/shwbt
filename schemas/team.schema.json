{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StallAI Team",
  "type": "object",
  "required": ["team_id", "team_hash", "format_id", "members", "source"],
  "properties": {
    "team_id": {"type": "string"},
    "team_hash": {"type": "string", "minLength": 1},
    "format_id": {"type": "string"},
    "members": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["species", "moves"],
        "properties": {
          "species": {"type": "string"},
          "ability": {"type": ["string", "null"]},
          "item": {"type": ["string", "null"]},
          "nature": {"type": ["string", "null"]},
          "evs": {"type": "object"},
          "ivs": {"type": "object"},
          "moves": {"type": "array", "minItems": 1, "maxItems": 4},
          "tera_type": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "tags": {"type": "array", "items": {"type": "string"}},
    "source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string"},
        "uri": {"type": ["string", "null"]},
        "captured_at": {"type": ["string", "null"]},
        "source_hash": {"type": ["string", "null"]},
        "parent_team_ids": {"type": "array", "items": {"type": "string"}},
        "mutation_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
