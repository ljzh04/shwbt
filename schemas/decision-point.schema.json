{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StallAI Decision Point",
  "type": "object",
  "required": [
    "schema_version",
    "decision_id",
    "run_id",
    "battle_id",
    "turn",
    "actor",
    "format_id",
    "simulator_commit",
    "agent_version",
    "objective_version",
    "state_hash",
    "state",
    "legal_actions",
    "chosen_action",
    "transition",
    "outcome_source",
    "objective_delta"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "decision_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "battle_id": {"type": "string", "minLength": 1},
    "turn": {"type": "integer", "minimum": 1},
    "actor": {"enum": ["p1", "p2", "p3", "p4"]},
    "format_id": {"type": "string", "minLength": 1},
    "simulator_commit": {"type": "string", "minLength": 1},
    "agent_version": {"type": "string", "minLength": 1},
    "objective_version": {"type": "string", "minLength": 1},
    "dataset_source": {"enum": ["selfplay", "historical_replay", "adversarial", "benchmark", "live"]},
    "state_hash": {"type": "string", "minLength": 1},
    "state": {"type": "object"},
    "legal_actions": {"type": "array"},
    "belief": {"type": "object"},
    "candidate_scores": {"type": "array"},
    "search": {"type": "object"},
    "chosen_action": {"type": "object"},
    "realized_opponent_action": {"type": ["object", "null"]},
    "transition": {"type": "object"},
    "outcome_source": {"enum": ["observed", "simulated"]},
    "objective_delta": {"type": "object"},
    "timestamp": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
